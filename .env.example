# SandboxMCP environment configuration
# Copy this file to `.env` and adjust the values for your environment:
#   cp .env.example .env
# All runtime settings use the `SANDBOX_` prefix (see src/sandboxmcp/config.py).

# --- Transport ---
# `stdio` (default, for Claude Desktop / Cursor / local MCP clients)
#        or `http` (for Docker / network deployments, Render, etc.)
SANDBOX_MCP_TRANSPORT=stdio

# Port used when transport is `http` (default: 8000)
PORT=8000

# --- Database ---
# SQLAlchemy database URL (e.g. sqlite:////absolute/path/to/app.db or postgresql+asyncpg://user:pass@host/db)
SANDBOX_DB_URL=sqlite:////tmp/sandbox/app.db

# Maximum number of rows returned by query_readonly_db
SANDBOX_MAX_ROWS=100

# --- Logs ---
# Absolute path to the service log file
SANDBOX_LOG_FILE=/var/log/sandbox/service.log

# --- Isolated Docker execution ---
# Base image for ephemeral test containers
SANDBOX_DOCKER_IMAGE=python:3.14-slim
# Hard memory limit (MB) per sandboxed container
SANDBOX_DOCKER_MEMORY_MB=256
# CPU quota (cores) per sandboxed container
SANDBOX_DOCKER_CPU_CORES=0.5
# Wall-clock timeout (seconds) per sandboxed run
SANDBOX_TEST_TIMEOUT_SECONDS=30
